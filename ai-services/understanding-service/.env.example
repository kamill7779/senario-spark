# Copy to .env and fill values locally. Do not commit .env.

EPISODE_ID=ep_003
VIDEO_INPUT=/input/episode.mp4

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=senario
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=senario_spark

ZHIPUAI_API_KEY=your_zhipuai_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# Use fallback models locally when keys are absent or while testing container boot.
ALLOW_MODEL_FALLBACK=1
OUTPUT_ROOT=/app/outputs
WAIT_FOR_MYSQL=1
MYSQL_WAIT_TIMEOUT_SECONDS=90

# Optional model overrides.
ZHIPUAI_ASR_MODEL=glm-asr-2512
ZHIPUAI_VLM_MODEL=glm-4v-flash
DEEPSEEK_MODEL=deepseek-chat
